programa{
    funcao inicio () {
        inteiro numero 

        escreva("De qual número você deseja ver a tabuada?")
        leia(numero)

        escreva("---Tabuada do",numero,"---\n")

        //0 contador "i" começa em 1, vai até 10 aumenta de 1 em 1 (i++)
        para(inteiro i=i; i ,= 10, i++) {
            inteiro resultado =numero*idadeescreva(numero, "x", i, "=",resultado, "\n")
        }
    }
}