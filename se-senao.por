programa {
    funcao inicio () {
        inteiro idade
        escreva ("digitei sua idade")
        leia(idade)

        se(idade>=18) {
        escreva ("Acesso negado")
        escreva("bem-vindo ao sistema!")
    } senao {
            escreva("acesso negado.")
            escreva ("menores não permitidos.")
    }
    }
 }