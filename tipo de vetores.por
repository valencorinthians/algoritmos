programa {
  funcao inicio() {
    // Sintaxe: tipo [tamanho]

    inteiro nota[5]  //vetor de 5 inteiros
    real altura[10]  //vetor de 10 reais
    cadeia nomes[3]  //vetor de 3 cadeias
    logico respostas[4]  //vetor de  4 lógicas

       //atribuindo valores individualmente:
       nota[0] = 10
       nota[1] = 2
       nota[2] = 3
       nota[3] = 9
       nota[4] = 7

       altura[0] = 1.40
       altura[1] = 1.69
       altura[2] = 1.90
       altura[3] = 1.22
       altura[4] = 1.13
       altura[5] = 1.34
       altura[6] = 2.04
       altura[7] = 3.09
       altura[8] = 1.64
       altura[9] = 1.30

       nomes[0] = "Valentina"
       nomes[1] = "Marina"
       nomes[2] = "Mariana"

       respostas[0] = verdadeiro
       respostas[1] = falso
       respostas[2] = verdadeiro
       respostas[3] = falso

       escreva(nota [0], "\n")
       escreva(nota [1], "\n")
       escreva(nota [2], "\n")
       escreva(nota [3], "\n")
       escreva(nota [4], "\n")

       escreva(altura[0], "\n")
       escreva(altura[1], "\n")
       escreva(altura[2], "\n")
       escreva(altura[3], "\n")
       escreva(altura[4], "\n")
       escreva(altura[5], "\n")
       escreva(altura[6], "\n")
       escreva(altura[7], "\n")
       escreva(altura[8], "\n")
       escreva(altura[9], "\n")
       
       escreva(nomes[0], "\n")
       escreva(nomes[1], "\n")
       escreva(nomes[2], "\n")

       escreva(respostas[0], "\n")
       escreva(respostas[1], "\n")
       escreva(respostas[2], "\n")
       escreva(respostas[3], "\n")


       


  }
}
